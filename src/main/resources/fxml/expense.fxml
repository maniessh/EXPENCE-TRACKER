<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.controller.ExpenseController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
    
    <Label text="Add Expense" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    
    <VBox spacing="10">
        <Label text="Amount:" style="-fx-font-size: 12;"/>
        <TextField fx:id="amountField" promptText="Enter amount"/>
        
        <Label text="Category:" style="-fx-font-size: 12;"/>
        <ComboBox fx:id="categoryComboBox" prefWidth="200.0"/>
        
        <Label text="Description:" style="-fx-font-size: 12;"/>
        <TextField fx:id="descriptionField" promptText="Enter description"/>
        
        <Label text="Date:" style="-fx-font-size: 12;"/>
        <DatePicker fx:id="datePicker"/>
        
        <Button text="Add Expense" onAction="#handleAddExpense" style="-fx-font-size: 12; -fx-padding: 10px 30px;"/>
    </VBox>
    
    <Separator/>
    
    <Label text="Recent Expenses" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
    <TableView fx:id="expenseTableView" prefHeight="300.0"/>
</VBox>
