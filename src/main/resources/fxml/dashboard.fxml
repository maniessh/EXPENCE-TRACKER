<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.controller.DashboardController">
    <top>
        <HBox style="-fx-background-color: #2c3e50;" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10"/>
            </padding>
            <Label text="Expense Tracker Dashboard" style="-fx-font-size: 20; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20"/>
            </padding>
            
            <HBox spacing="20">
                <VBox style="-fx-border-color: #2c3e50; -fx-border-width: 1;" spacing="10">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <Label text="Total Income" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="totalIncomeLabel" text="$0.00" style="-fx-font-size: 18; -fx-text-fill: green;"/>
                </VBox>
                
                <VBox style="-fx-border-color: #2c3e50; -fx-border-width: 1;" spacing="10">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <Label text="Total Expense" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="totalExpenseLabel" text="$0.00" style="-fx-font-size: 18; -fx-text-fill: red;"/>
                </VBox>
                
                <VBox style="-fx-border-color: #2c3e50; -fx-border-width: 1;" spacing="10">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <Label text="Balance" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="balanceLabel" text="$0.00" style="-fx-font-size: 18; -fx-text-fill: blue;"/>
                </VBox>
            </HBox>
            
            <TabPane>
                <Tab text="Transactions" closable="false">
                    <TableView/>
                </Tab>
                <Tab text="Charts" closable="false">
                    <VBox/>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
