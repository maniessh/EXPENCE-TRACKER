<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.controller.ProfileController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
    
    <Label text="Expense Tracker" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
    
    <VBox spacing="10">
        <Label text="Username:" style="-fx-font-size: 14;"/>
        <TextField fx:id="usernameField" promptText="Enter username"/>
        
        <Label text="Password:" style="-fx-font-size: 14;"/>
        <PasswordField fx:id="passwordField" promptText="Enter password"/>
    </VBox>
    
    <HBox spacing="10" alignment="CENTER">
        <Button text="Login" style="-fx-font-size: 12; -fx-padding: 10px 30px;"/>
        <Button text="Register" style="-fx-font-size: 12; -fx-padding: 10px 30px;"/>
    </HBox>
</VBox>
